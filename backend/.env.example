APP_NAME="PawCare API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://pawcare-api.test

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# sqlite uses database/database.sqlite; do not set DB_URL or PostgreSQL options

CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SANCTUM_EXPIRATION=43200

AI_SERVICE_URL=http://127.0.0.1:8001
AI_CONNECT_TIMEOUT=2
AI_REQUEST_TIMEOUT=15
AI_DEMO_FALLBACK=true

<?xml version="1.0" encoding="utf-8"?>
<!--screen structure; DashboardActivity supplies account data and button actions-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="18dp"
    android:paddingEnd="20dp"
    android:paddingBottom="32dp"
    tools:context=".DashboardActivity">
    <TextView
        android:id="@+id/aiTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Recognize a breed"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/paw_text"
        android:lineSpacingMultiplier="1.1" />
    <TextView
        android:id="@+id/aiSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Choose a clear, well-lit photo with one cat or dog."
        android:textSize="15sp"
        android:textStyle="normal"
        android:textColor="@color/paw_muted"
        android:lineSpacingMultiplier="1.1"
        android:layout_marginTop="4dp" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/aiLinkedPet"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Link to a pet (optional)"
        app:cornerRadius="14dp"
        android:layout_marginTop="18dp" />
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/aiPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        app:cardCornerRadius="22dp"
        app:cardBackgroundColor="@color/paw_surface_variant"
        app:strokeColor="@color/paw_primary"
        app:strokeWidth="1dp">
        <LinearLayout
            android:id="@+id/aiPlaceholder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="26dp"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/aiCameraIcon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📷"
                android:textSize="46sp"
                android:textStyle="normal"
                android:textColor="@color/paw_text"
                android:lineSpacingMultiplier="1.1"
                android:gravity="center" />
            <TextView
                android:id="@+id/aiPlaceholderTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No photo selected"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/paw_text"
                android:lineSpacingMultiplier="1.1"
                android:gravity="center"
                android:layout_marginTop="8dp" />
            <TextView
                android:id="@+id/aiPlaceholderSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="JPG, PNG, or WebP · maximum 10 MB"
                android:textSize="13sp"
                android:textStyle="normal"
                android:textColor="@color/paw_muted"
                android:lineSpacingMultiplier="1.1"
                android:gravity="center"
                android:layout_marginTop="4dp" />
        </LinearLayout>
        <ImageView
            android:id="@+id/aiPhoto"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:contentDescription="Selected pet photo"
            android:scaleType="centerCrop"
            android:visibility="gone" />
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/aiChoosePhoto"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Choose photo"
        app:cornerRadius="14dp"
        android:layout_marginTop="14dp" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/aiAnalyze"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Analyze breed"
        app:cornerRadius="14dp"
        android:layout_marginTop="10dp" />
    <LinearLayout
        android:id="@+id/aiProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginTop="20dp"
        android:visibility="gone">
        <ProgressBar
            android:layout_width="28dp"
            android:layout_height="28dp" />
        <TextView
            android:id="@+id/aiProgressText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Analyzing image…"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/paw_text"
            android:lineSpacingMultiplier="1.1"
            android:layout_marginLeft="12dp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/aiFeedback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
    <TextView
        android:id="@+id/aiDisclaimer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="AI results are guidance only. Breed predictions can be wrong, especially for mixed breeds. They do not provide a medical diagnosis."
        android:textSize="12sp"
        android:textStyle="normal"
        android:textColor="@color/paw_muted"
        android:lineSpacingMultiplier="1.1"
        android:layout_marginTop="18dp" />
    <TextView
        android:id="@+id/aiHistoryTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Saved prediction history"
        android:textSize="19sp"
        android:textStyle="bold"
        android:textColor="@color/paw_text"
        android:lineSpacingMultiplier="1.1"
        android:layout_marginTop="26dp" />
    <LinearLayout
        android:id="@+id/aiHistory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
</LinearLayout>
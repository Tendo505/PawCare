<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    android:id="@+id/recordCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="20dp"
    app:cardElevation="1dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/paw_surface_variant"
    app:cardBackgroundColor="@color/white"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
        <TextView
            android:id="@+id/recordTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/paw_text"
            android:lineSpacingMultiplier="1.1"
            tools:text="Record title" />
        <TextView
            android:id="@+id/recordSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="14sp"
            android:textStyle="normal"
            android:textColor="@color/paw_primary"
            android:lineSpacingMultiplier="1.1"
            android:layout_marginTop="4dp"
            tools:text="Pet · Date" />
        <TextView
            android:id="@+id/recordDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="13sp"
            android:textStyle="normal"
            android:textColor="@color/paw_muted"
            android:lineSpacingMultiplier="1.1"
            android:layout_marginTop="5dp"
            android:visibility="gone"
            tools:text="Record details" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:layout_marginTop="8dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/recordEdit"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:text="Edit"
                app:cornerRadius="12dp"
                android:textSize="12sp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginLeft="8dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/recordDelete"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:text="Delete"
                app:cornerRadius="12dp"
                android:textSize="12sp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginLeft="8dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
<?xml version="1.0" encoding="utf-8"?>
<!--Home tab. HomeScreen.kt fills in the account name, numbers and reminders, and connects the buttons-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="18dp"
    android:paddingEnd="20dp"
    android:paddingBottom="32dp"
    tools:context=".DashboardActivity">
    <!--greeting: "Hello, <first name>"-->
    <TextView
        android:id="@+id/homeGreeting"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Hello 👋"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/paw_text"
        android:lineSpacingMultiplier="1.1" />
    <TextView
        android:id="@+id/homeSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Here is your pet care overview."
        android:textSize="15sp"
        android:textStyle="normal"
        android:textColor="@color/paw_muted"
        android:lineSpacingMultiplier="1.1"
        android:layout_marginTop="4dp" />
    <!--green welcome banner-->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/homeHero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardElevation="1dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/paw_surface_variant"
        app:cardBackgroundColor="@color/paw_primary"
        android:layout_marginTop="22dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">
            <TextView
                android:id="@+id/homeHeroTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Healthy routines, happier paws"
                android:textSize="21sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:lineSpacingMultiplier="1.1" />
            <TextView
                android:id="@+id/homeHeroSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Track visits, vaccines, and reminders in one private place."
                android:textSize="14sp"
                android:textStyle="normal"
                android:textColor="@color/white"
                android:lineSpacingMultiplier="1.1"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <!--connection card: is Laravel, the database and the AI service working? (filled by HomeScreen.showConnection)-->
    <TextView
        android:id="@+id/homeConnectionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="System connection"
        android:textSize="19sp"
        android:textStyle="bold"
        android:textColor="@color/paw_text"
        android:lineSpacingMultiplier="1.1"
        android:layout_marginTop="24dp" />
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/homeConnection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardElevation="1dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/paw_surface_variant"
        app:cardBackgroundColor="@color/white"
        android:layout_marginTop="10dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">
            <TextView
                android:id="@+id/connectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Checking system services…"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/paw_text"
                android:lineSpacingMultiplier="1.1" />
            <TextView
                android:id="@+id/connectionLaravel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Laravel API: Checking"
                android:textSize="13sp"
                android:textStyle="normal"
                android:textColor="@color/paw_muted"
                android:lineSpacingMultiplier="1.1"
                android:layout_marginTop="8dp" />
            <TextView
                android:id="@+id/connectionDatabase"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PostgreSQL: Checking"
                android:textSize="13sp"
                android:textStyle="normal"
                android:textColor="@color/paw_muted"
                android:lineSpacingMultiplier="1.1"
                android:layout_marginTop="4dp" />
            <TextView
                android:id="@+id/connectionAi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AI service: Checking"
                android:textSize="13sp"
                android:textStyle="normal"
                android:textColor="@color/paw_muted"
                android:lineSpacingMultiplier="1.1"
                android:layout_marginTop="4dp" />
            <TextView
                android:id="@+id/connectionModel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="12sp"
                android:textStyle="normal"
                android:textColor="@color/paw_muted"
                android:lineSpacingMultiplier="1.1"
                android:layout_marginTop="4dp"
                android:visibility="gone" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/connectionRetry"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:text="Check again"
                app:cornerRadius="12dp"
                android:textSize="12sp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginTop="12dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <!--four totals: pets, vaccines due, appointments, health records (filled by HomeScreen.showTotals)-->
    <TextView
        android:id="@+id/homeStatsTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="At a glance"
        android:textSize="19sp"
        android:textStyle="bold"
        android:textColor="@color/paw_text"
        android:lineSpacingMultiplier="1.1"
        android:layout_marginTop="24dp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/petStat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="0dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="1dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/paw_surface_variant"
            app:cardBackgroundColor="@color/white">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">
                <TextView
                    android:id="@+id/petStatIcon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🐾"
                    android:textSize="22sp"
                    android:textStyle="normal"
                    android:textColor="@color/paw_text"
                    android:lineSpacingMultiplier="1.1" />
                <TextView
                    android:id="@+id/petStatValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:textColor="@color/paw_text"
                    android:lineSpacingMultiplier="1.1"
                    android:layout_marginTop="6dp" />
                <TextView
                    android:id="@+id/petStatCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pets"
                    android:textSize="12sp"
                    android:textStyle="normal"
                    android:textColor="@color/paw_muted"
                    android:lineSpacingMultiplier="1.1"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/vaccineStat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="10dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="1dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/paw_surface_variant"
            app:cardBackgroundColor="@color/white">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">
                <TextView
                    android:id="@+id/vaccineStatIcon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="💉"
                    android:textSize="22sp"
                    android:textStyle="normal"
                    android:textColor="@color/paw_text"
                    android:lineSpacingMultiplier="1.1" />
                <TextView
                    android:id="@+id/vaccineStatValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:textColor="@color/paw_text"
                    android:lineSpacingMultiplier="1.1"
                    android:layout_marginTop="6dp" />
                <TextView
                    android:id="@+id/vaccineStatCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Vaccines due"
                    android:textSize="12sp"
                    android:textStyle="normal"
                    android:textColor="@color/paw_muted"
                    android:lineSpacingMultiplier="1.1"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">
        <!--second row of totals: appointments and health records-->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/appointmentStat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="0dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="1dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/paw_surface_variant"
            app:cardBackgroundColor="@color/white">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">
                <TextView
                    android:id="@+id/appointmentStatIcon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📅"
                    android:textSize="22sp"
                    android:textStyle="normal"
                    android:textColor="@color/paw_text"
                    android:lineSpacingMultiplier="1.1" />
                <TextView
                    android:id="@+id/appointmentStatValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:textColor="@color/paw_text"
                    android:lineSpacingMultiplier="1.1"
                    android:layout_marginTop="6dp" />
                <TextView
                    android:id="@+id/appointmentStatCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Appointments"
                    android:textSize="12sp"
                    android:textStyle="normal"
                    android:textColor="@color/paw_muted"
                    android:lineSpacingMultiplier="1.1"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/medicalStat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="10dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="1dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/paw_surface_variant"
            app:cardBackgroundColor="@color/white">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">
                <TextView
                    android:id="@+id/medicalStatIcon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🩺"
                    android:textSize="22sp"
                    android:textStyle="normal"
                    android:textColor="@color/paw_text"
                    android:lineSpacingMultiplier="1.1" />
                <TextView
                    android:id="@+id/medicalStatValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:textColor="@color/paw_text"
                    android:lineSpacingMultiplier="1.1"
                    android:layout_marginTop="6dp" />
                <TextView
                    android:id="@+id/medicalStatCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Health records"
                    android:textSize="12sp"
                    android:textStyle="normal"
                    android:textColor="@color/paw_muted"
                    android:lineSpacingMultiplier="1.1"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
    <!--reminder cards are added into homeReminders by HomeScreen.showReminders-->
    <TextView
        android:id="@+id/homeRemindersTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Coming up"
        android:textSize="19sp"
        android:textStyle="bold"
        android:textColor="@color/paw_text"
        android:lineSpacingMultiplier="1.1"
        android:layout_marginTop="24dp" />
    <LinearLayout
        android:id="@+id/homeReminders"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
    <!--quick action buttons: Add pet, Book visit, Recognize a breed-->
    <TextView
        android:id="@+id/homeActionsTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Quick actions"
        android:textSize="19sp"
        android:textStyle="bold"
        android:textColor="@color/paw_text"
        android:lineSpacingMultiplier="1.1"
        android:layout_marginTop="24dp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/homeAddPet"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Add pet"
            app:cornerRadius="14dp"
            android:layout_weight="1" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/homeBookVisit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Book visit"
            app:cornerRadius="14dp"
            android:layout_weight="1"
            android:layout_marginLeft="10dp" />
    </LinearLayout>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/homeRecognize"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Recognize a breed"
        app:cornerRadius="14dp"
        android:layout_marginTop="10dp" />
</LinearLayout>
